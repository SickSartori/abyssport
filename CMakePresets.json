{
  "version": 6,
  "configurePresets": [
    {
      "name": "pc-x64",
      "displayName": "PC - Windows x64 (llvm-mingw, Ninja)",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/llvm-mingw.cmake",
      "binaryDir": "${sourceDir}/build/pc-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "pc-x64-release", "configurePreset": "pc-x64" }
  ],
  "testPresets": [
    { "name": "pc-x64", "configurePreset": "pc-x64", "output": { "outputOnFailure": true } }
  ]
}
